{
  "name": "dooo",
  "productName": "Dooo",
  "version": "1.0.0",
  "description": "Floating project cards for your Windows desktop",
  "author": "5haa",
  "private": true,
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "start:server": "node src/server/server.js",
    "test:cloud": "node --test tests/cloud.test.js",
    "test:cloud:e2e": "node tests/cloud-electron.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis",
    "test:e2e": "node tests/e2e.js",
    "test:unit": "node tests/unit.js",
    "test:ai": "node --test tests/ai.test.js",
    "test:ai:e2e": "node tests/ai-electron.js",
    "start:mcp": "node src/agents/mcp.js",
    "connect:agents": "node scripts/connect-agents.js",
    "test:agents": "node --test tests/agents.test.js",
    "test:agents:e2e": "node tests/agents-integration.js",
    "build:ui-tars": "node packages/ui-tars/build.js",
    "start:worker": "electron apps/worker/host.js",
    "test:control": "node --test tests/control.test.js",
    "test:control:e2e": "node tests/control-e2e.js",
    "prestart": "npm run build:ui-tars",
    "prepack": "npm run build:ui-tars",
    "predist": "npm run build:ui-tars"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0"
  },
  "build": {
    "appId": "com.5haa.dooo",
    "productName": "Dooo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "apps/worker/**/*",
      "packages/ui-tars/**/*",
      "packages/control/**/*",
      "vendor/ui-tars/LICENSE",
      "vendor/ui-tars/UPSTREAM.md"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dooo",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Dooo-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "@dooo/ui-tars": "*"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
